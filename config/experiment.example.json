{
  "schema_version": 1,
  "repository": "C:/source/product",
  "repository_id": "product-main",
  "revision": "main",
  "output": "C:/repotraverse/experiments/head-main",
  "artifact_cache": "C:/repotraverse/experiments/artifact-cache-v1",
  "extractor": "C:/repotraverse/bin/clang-extractor.exe",
  "extractor_timeout_seconds": 1800,
  "extractor_concurrency": 8,
  "max_manifest_bytes": 268435456,
  "workspace_max_revisions": 2,
  "workspace_max_bytes": 10737418240,
  "workspace_free_space_reserve_bytes": 5368709120,
  "configurations": [
    {
      "name": "product-a-cortex-r5-clang-poc",
      "build_variant": {
        "product": "product-a",
        "target": "cortex-r5",
        "configuration": "clang-poc"
      },
      "toolchain": "armclang6",
      "working_directory": ".",
      "command": [
        "make.exe",
        "CC={compiler_probe}",
        "CXX={compiler_probe}",
        "-j8",
        "objects"
      ],
      "prepare_command": ["make.exe", "-j8", "generated-headers"],
      "compiler_variables": ["CC", "CXX"],
      "real_compiler": "C:/llvm-sdk/bin/clang.exe",
      "timeout_seconds": 3600,
      "environment": {
        "PRODUCT": "A",
        "TARGET": "cortex-r5",
        "CONFIGURATION": "clang-poc"
      }
    }
  ],
  "pilot": {
    "ref": "main",
    "max_revisions": 20,
    "budget": {
      "common_leakage": {
        "max_files": 20,
        "max_syntax_transitions": 100,
        "max_semantic_elements": 20
      },
      "variable_detail": {
        "max_files": 20,
        "max_syntax_transitions": 100,
        "max_semantic_elements": 20
      },
      "stable_island_candidates": {
        "max_files": 10,
        "max_syntax_transitions": 50,
        "max_semantic_elements": 10
      },
      "high_impact_headers": {
        "max_files": 10,
        "max_syntax_transitions": 50,
        "max_semantic_elements": 10
      },
      "controls": {
        "max_files": 10,
        "max_syntax_transitions": 50,
        "max_semantic_elements": 10
      },
      "max_capture_revisions": 20,
      "max_dependency_depth": 2,
      "max_induced_elements_per_transition": 100
    }
  },
  "partition": {
    "stable": ["platform/stable/*", "common/*"],
    "variable": ["products/*", "features/*"],
    "exclude": ["third_party/*", "generated/*"]
  },
  "policy": {
    "minimum_observable_transitions": 3,
    "half_life_transitions": 8.0,
    "half_life_days": 90.0,
    "stable_threshold": 0.15,
    "variable_threshold": 0.75,
    "implementation_weight": 1.0,
    "interface_weight": 4.0,
    "dependency_weight": 2.0,
    "move_weight": 0.2,
    "rename_weight": 0.2
  }
}
